APP_NAME=GHASIDO
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Inertia's request recorder; keep off except while debugging locally.
INERTIA_DEVTOOLS=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Must exceed the longest job timeout (AI lesson generation), or a slow job
# is handed to a second worker and billed twice.
DB_QUEUE_RETRY_AFTER=960

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# The first platform owner, created by SuperAdminSeeder (spec 0001).
# Leave all three blank and no account is created, so a fresh clone sets up
# cleanly. Fill them in, then run `php artisan db:seed --force`.
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# AI, text-to-speech and speech-to-text providers (spec 0003 Part C).
# `fake` needs no key and is what CI, tests and the seeder run against.
# Real values: AI_PROVIDER=anthropic | openai | qwen, TTS_PROVIDER=deepgram, STT_PROVIDER=deepgram (nova-3; key falls back to DEEPGRAM_API_KEY) | openai.
# Qwen and any OpenAI-compatible chat endpoint use AI_PROVIDER=qwen with
# AI_BASE_URL pointing at the provider's compatible-mode /v1 URL.
AI_PROVIDER=fake
AI_MODEL=
AI_BASE_URL=
AI_KEY=
# Faster model for learner-facing turns (e.g. qwen3.8-flash); falls back to AI_MODEL.
AI_FAST_MODEL=
# Image generation (DashScope async task API, native /api/v1 root). AI_IMAGE_PROVIDER=fake|qwen
# defaults to qwen when AI_PROVIDER=qwen, else fake.
AI_IMAGE_MODEL=
AI_IMAGE_BASE_URL=
# AI_IMAGE_KEY=   (optional; defaults to AI_KEY)
# Deepgram Voice Agent (live spoken role-play). Falls back to DEEPGRAM_API_KEY;
# the browser only ever receives a short-lived token.
# DEEPGRAM_AGENT_KEY=   (optional; defaults to DEEPGRAM_API_KEY)
DEEPGRAM_AGENT_TOKEN_TTL=60
TTS_PROVIDER=fake
TTS_VOICE=flux-brittany-en
TTS_BASE_URL=
TTS_KEY=
DEEPGRAM_API_KEY=
TTS_MODEL=flux-brittany-en
TTS_EXPRESSIVITY=0
STT_PROVIDER=fake
STT_BASE_URL=
STT_KEY=
STT_MODEL=
